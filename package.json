{
  "name": "lantern",
  "version": "2.0.0-dev",
  "description": "Personal Bible study notes — web-first PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/upload-sourcemaps.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "build:word-index": "tsx scripts/build-word-index.mjs"
  },
  "dependencies": {
    "@fontsource/newsreader": "^5.2.10",
    "@fontsource/noto-serif-tamil": "^5.3.0",
    "@fontsource/source-serif-4": "^5.2.9",
    "@supabase/supabase-js": "^2.110.0",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "better-sqlite3": "^12.11.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "prettier": "^3.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  }
}
